# URL to the backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000/api

# Meta Pixel ID (Events Manager -> Data Sources -> your pixel -> Settings).
# Only used in production builds (see src/config/tracking.js) — `npm run dev`
# never fires real ad events regardless of this value.
VITE_META_PIXEL_ID=1493161325318690

# Sitewide order-pause switch (see src/config/ordering.js). When "true",
# shows a banner on every page and disables all "Buy now" / "Direct Order"
# actions. Currently "true" in production — set back to "false" (or unset)
# once ordering reopens.
VITE_ORDERING_PAUSED=true
