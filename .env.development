# Local development: `npm run dev` auto-connects to the local backend.
# Vite loads this file only in dev mode; production builds ignore it.
VITE_API_BASE_URL=http://localhost:3000/api

# Mirrors the live production setting so the paused-ordering banner and
# disabled buttons are visible locally too. Remove this line once ordering
# reopens (see .env.example / netlify.toml / deploy-pages.yml).
VITE_ORDERING_PAUSED=true
