# Loaded by `vite build` (and the sitemap script) for every production build,
# so hosts like Vercel need no dashboard env setup. All values are public —
# they end up in the shipped bundle anyway. Never put secrets here (the Meta
# Conversions API token lives only in the backend's Railway env).
# Env vars set by the host (GitHub Actions, netlify.toml, Vercel dashboard)
# override anything in this file.

VITE_API_BASE_URL=https://api-production-38d4.up.railway.app/api
VITE_META_PIXEL_ID=1493161325318690
VITE_GA_MEASUREMENT_ID=G-QF09GWRXLV
# Canonical public address (Vercel custom domain) — used for canonical tags,
# Open Graph URLs, sitemap.xml and robots.txt on every deployment.
VITE_SITE_URL=https://lullaby-rituals.com
