generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Ось ця модель, яку Prisma не могла знайти
model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  products    Product[]
}

model Product {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String?
  price         Decimal
  scent         String
  color         String
  stock         Int       @default(0)
  image_url     String?
  is_active     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])

  imageKey      String?
  imageBucket   String?
  imageMimeType String?
  imageSize     Int?
}